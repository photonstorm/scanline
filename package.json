{
  "name": "scanline",
  "version": "0.0.1",
  "private": true,
  "license": "PolyForm-Shield-1.0.0",
  "description": "A browser for debugging WebGL and WebGPU rendering, driven by an agent and shared with a person.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "gen:hooks": "node probe/tools/gen-hooks.mjs",
    "build:probe": "node probe/build.mjs",
    "typecheck": "tsc -p probe/tsconfig.json --noEmit && tsc -p replay/tsconfig.json --noEmit",
    "test:probe": "node --test --test-concurrency=1 --test-timeout=60000 probe/test/*.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 --test-timeout=120000 tests/e2e.test.mjs",
    "test": "npm run build && npm run typecheck && npm run test:wgsl && npm run test:probe && npm run test:bugs && cargo test && cargo build && npm run test:e2e && npm run test:findings && npm run test:webgpu && npm run test:journeys && npm run test:protocol && npm run test:security && npm run test:package",
    "test:wgsl": "node --test replay/test/*.test.mjs",
    "test:webgpu": "node --test --test-concurrency=1 --test-timeout=180000 tests/webgpu.test.mjs",
    "build:replay": "node replay/build.mjs",
    "build": "npm run build:probe && npm run build:replay",
    "test:bugs": "node --test --test-concurrency=1 --test-timeout=60000 tests/bugs.test.mjs",
    "test:findings": "node --test --test-concurrency=1 --test-timeout=120000 tests/findings.test.mjs",
    "test:journeys": "node --test --test-concurrency=1 --test-timeout=180000 tests/journeys.test.mjs",
    "test:protocol": "node --test --test-concurrency=1 --test-timeout=120000 tests/protocol.test.mjs",
    "test:security": "node --test --test-concurrency=1 --test-timeout=120000 tests/security.test.mjs",
    "test:package": "node --test --test-concurrency=1 --test-timeout=120000 tests/package.test.mjs",
    "package": "node tools/package.mjs"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.74",
    "@webref/idl": "^3.86.0",
    "babylonjs": "^9.35.0",
    "esbuild": "^0.28.2",
    "phaser": "^4.2.1",
    "pixi.js": "^8.22.0",
    "playcanvas": "^2.24.0",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "webidl2": "^24.5.0"
  }
}
