{
  "name": "scanline",
  "version": "0.0.1",
  "private": true,
  "description": "A browser for debugging WebGL and WebGPU rendering, driven by an agent and shared with a person.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "gen:hooks": "node probe/tools/gen-hooks.mjs",
    "build:probe": "node probe/build.mjs",
    "typecheck": "tsc -p probe/tsconfig.json --noEmit",
    "test:probe": "node --test --test-concurrency=1 --test-timeout=60000 probe/test/*.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 --test-timeout=120000 tests/*.test.mjs",
    "test": "npm run build:probe && npm run typecheck && npm run test:probe && cargo test && cargo build && npm run test:e2e"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.74",
    "@webref/idl": "^3.86.0",
    "babylonjs": "^9.35.0",
    "esbuild": "^0.28.2",
    "phaser": "^4.2.1",
    "pixi.js": "^8.22.0",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "webidl2": "^24.5.0"
  }
}
